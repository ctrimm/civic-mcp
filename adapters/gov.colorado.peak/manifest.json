{
  "id": "gov.colorado.peak",
  "name": "Colorado PEAK Benefits",
  "version": "0.1.0",
  "author": "civic-mcp contributors",
  "description": "Tools for Colorado PEAK \u2014 the state's portal for SNAP, Health First Colorado (Medicaid), Colorado Works, and CHP+: benefits directory, interactive finder, guest application handoff, and status check",
  "homepage": "https://peak.my.site.com",
  "repository": "https://github.com/civic-mcp/civic-mcp",
  "license": "MIT",
  "domains": [
    "peak.my.site.com",
    "colorado.gov"
  ],
  "tools": [
    {
      "name": "find_benefits",
      "securityLevel": "read_only",
      "category": "info"
    },
    {
      "name": "open_benefits_finder",
      "securityLevel": "read_only",
      "category": "eligibility"
    },
    {
      "name": "start_application",
      "securityLevel": "write",
      "category": "application"
    },
    {
      "name": "check_application_status",
      "securityLevel": "read_only",
      "category": "status"
    }
  ],
  "permissions": {
    "required": [
      "read:forms",
      "write:forms",
      "navigate"
    ],
    "optional": [
      "storage:local",
      "notifications"
    ]
  },
  "trustLevel": "community",
  "verified": false,
  "category": "state_benefits",
  "tags": [
    "SNAP",
    "Medicaid",
    "Colorado Works",
    "CHP+",
    "Colorado"
  ],
  "state": "CO"
}
